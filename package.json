{
  "name": "game-general-engine",
  "version": "1.0.0",
  "description": "Reusable game engine for hidden object games with puzzles - TypeScript + Phaser",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "type-check": "tsc --noEmit",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "keywords": [
    "game",
    "phaser",
    "typescript",
    "hidden-object",
    "puzzle",
    "mobile"
  ],
  "author": "Bhavan T Channira",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/core": "^5.5.1",
    "@capacitor/ios": "^5.5.1",
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.1",
    "@types/node": "^20.10.0",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.5.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
